# Local environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.cache/
.DS_Store

# Uncurated simulation output and third-party source material
/runs/
/pshonkin_materials_ishodniki/
/diagnostics/
/monitor_snapshots/
*.lammpstrj
*.start.data
restart.*
*.restart.*
potentials/**/*.tar.gz

# Published primary data are compressed and checksummed under data/.
!data/**/*.gz

# Editor state and local working notes
/.codex/
/.firecrawl/
/docs/_local/
agent_report*.md
prompt*.txt
*.stackdump
*.tmp
*.swp

# Manuscript build products; current reading PDFs are tracked deliberately.
/build/
*.aux
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.spl
docs/paper/*.log
docs/paper/*.out
docs/paper/*.toc
docs/paper/_docx_build/
docs/paper/*_editable.docx
docs/paper/overleaf_*.zip
