# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Local editor / temp
*.tmp
*.temp
*.swp
*.swo
.cache/

# Large raw MD trajectories — kept LOCAL, never committed
*.lammpstrj

# Heavy visual-debug artifacts — regenerable, kept local
*.xyz

# Large raw structure data — kept local. Specific small starting structures needed to
# continue Stage A0 on another machine are force-added explicitly (`git add -f <path>`).
data.*

# Local/private notes (supervisor questions, assessment, drafts) — not for the public repo
docs/_local/

# Supervisor source materials (copyrighted PDFs + unpublished manuscript) — do not publish
pshonkin_materials_ishodniki/

# Heavy / temporary MD run artifacts — kept LOCAL.
# The whole runs/ tree is also excluded via .git/info/exclude; these patterns make the
# intent explicit and also cover any stray copies outside runs/.
dump.*
restart.*
monitor_snapshots/
status_dump_*.txt

# Python tooling caches and local virtual environment
.pytest_cache/
.venv/
