# Static response of an Al/Al13Fe4 interface to a prescribed ridge displacement.
# The saved control and strained inputs share a relaxed reference configuration.
# Optional springs tether inclusion atoms to their input coordinates during
# minimisation. The interatomic potential is unchanged. There is no thermal stage.
#
# Metal units: angstrom, eV, ps, K and bar; stress/atom values are in bar*A^3.
# Variables supplied with -var:
#   DATA_FILE, POT_DIR, OUT_PREFIX  input data, MEAM directory, output prefix
#   N_AL                           matrix atom count; higher IDs are inclusion
#   HOLD_INCL                      1 enables inclusion springs, 0 disables them
#   KSPRING                        spring constant in eV/A^2
#   CG_MAX, CG_FTOL                 iteration limit and force two-norm in eV/A
# Atom types: 1 Al, 2 Fe, 3 Mg, 4 Si. The cell is periodic in x and y.

units           metal
atom_style      atomic
boundary        p p f

variable        HOLD_INCL index 1
variable        KSPRING index 20.0
variable        CG_MAX index 6000
variable        CG_FTOL index 0.02

read_data       ${DATA_FILE}

pair_style      meam
pair_coeff      * * ${POT_DIR}/Jelinek_2012_meamf AlS SiS MgS CuS FeS ${POT_DIR}/Jelinek_2012_meam.alsimgcufe AlS FeS MgS SiS

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check no

compute         st all stress/atom NULL virial

region          bottom block INF INF INF INF INF 6.0 units box
group           bottom region bottom
group           mobile subtract all bottom
fix             hold bottom setforce 0.0 0.0 0.0

variable        first_incl equal v_N_AL+1
group           inclusion id ${first_incl}:999999999
if "${HOLD_INCL} > 0" then &
   "fix tether inclusion spring/self ${KSPRING}" &
   "fix_modify tether energy yes"

thermo          100
thermo_style    custom step atoms pe press pzz pxz fnorm
thermo_modify   flush yes

min_style       cg
min_modify      dmax 0.05
minimize        0.0 ${CG_FTOL} ${CG_MAX} 60000

write_dump      all custom ${OUT_PREFIX}.gate.lammpstrj id type x y z c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6] modify sort id format float %.8g
