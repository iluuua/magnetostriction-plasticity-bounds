# 147 MPa compression-ramp controlled sanity run for Al/Fe4Al13 trial_001.
# DO NOT USE NPT. DO NOT RUN 200 MPa from this input.
# This is a controlled sanity-run, not final physical validation.

units           metal
dimension       3
boundary        p p f
atom_style      atomic

read_data       ../../../02_interface_relax/trial_001/data.interface_nvt_300k_long
