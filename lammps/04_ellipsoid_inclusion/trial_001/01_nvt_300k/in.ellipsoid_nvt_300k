units           metal
dimension       3
boundary        p p p
atom_style      atomic

read_data       ../00_minimize/data.ellipsoid_minimized

mass            1 26.9815385
mass            2 55.845

pair_style      meam
pair_coeff      * * ../../../../potentials/meam/Jelinek_2012/Jelinek_2012_meamf AlS SiS MgS CuS FeS ../../../../potentials/meam/Jelinek_2012/Jelinek_2012_meam.alsimgcufe AlS FeS

neighbor        2.0 bin
neigh_modify    delay 10 every 1 check yes

timestep        0.001

compute         pe_atom all pe/atom
compute         stress_atom all stress/atom NULL

thermo          100
thermo_style    custom step atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify   lost warn flush yes

velocity        all create 300.0 4928459 mom yes rot no dist gaussian

fix             nvt_all all nvt temp 300.0 300.0 0.1

dump            d1 all custom 100 dump.ellipsoid_nvt_300k.lammpstrj id type x y z c_pe_atom c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]
dump_modify     d1 sort id

run             5000

unfix           nvt_all
undump          d1

write_data      data.ellipsoid_nvt_300k
write_dump      all custom dump.ellipsoid_nvt_300k_final.lammpstrj id type x y z modify sort id
